{
  "name": "e2e-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,yml,yaml}\"",
    "check:run-docs-untracked": "node scripts/check-run-docs-untracked.mjs",
    "check:types": "node scripts/check-ts-types.mjs",
    "check:source-commits": "node scripts/check-source-commits.mjs",
    "triage:covered": "node scripts/list-covered-commits.mjs",
    "check:case-docs": "node scripts/check-case-docs.mjs",
    "check:english": "node scripts/check-english.mjs",
    "check:run-plan": "node scripts/check-run-plan.mjs",
    "check:comparison": "node scripts/check-comparison-model.mjs",
    "check:track": "node scripts/check-track-model.mjs",
    "check:verdict": "node --experimental-strip-types --test framework/verdict.test.js",
    "check:engine": "node --experimental-strip-types --test framework/engine.test.js",
    "check:feishu-card": "node --test scripts/send-feishu-summary.test.js",
    "check:conclude": "node --test scripts/conclude-check-run.test.js",
    "check:record-values": "node --experimental-strip-types --test framework/runners/record-values.test.js",
    "check:group-buckets": "node --experimental-strip-types --test framework/runners/group-buckets.test.js",
    "check:circular-append": "node --experimental-strip-types --test framework/runners/circular-append-burst-workload.test.js",
    "check": "pnpm format:check && pnpm check:run-docs-untracked && pnpm check:types && pnpm check:case-docs && pnpm check:source-commits && pnpm check:english && pnpm check:run-plan && pnpm check:comparison && pnpm check:track && pnpm check:verdict && pnpm check:engine && pnpm check:feishu-card && pnpm check:conclude && pnpm check:record-values && pnpm check:group-buckets && pnpm check:circular-append"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  }
}
